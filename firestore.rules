rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ahammam25101972@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users Collection
    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Memorials Collection (Public memorial pages)
    match /memorials/{memorialId} {
      // Anyone can read active memorial pages
      allow get: if true;
      allow list: if true;

      // Anyone can create a memorial with valid schema
      allow create: if isValidId(memorialId)
        && incoming().deceasedName is string
        && incoming().deceasedName.size() >= 2
        && incoming().deceasedName.size() <= 120
        && incoming().userId is string;

      // Updates allowed by owner, admin, or public interactions (counter increments)
      allow update: if (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['visitCount'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['prayerCount'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['visitCount', 'prayerCount'])) ||
        // Allow owner with matching userId token
        (incoming().userId == existing().userId && (existing().isSuspended != true || isAdmin()))
      );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || true;

      // Prayers Subcollection
      match /prayers/{prayerId} {
        allow read: if true;
        
        allow create: if isValidId(prayerId)
          && incoming().duaaText is string
          && incoming().duaaText.size() >= 2
          && incoming().duaaText.size() <= 1000;

        allow update: if true;
        allow delete: if true;
      }
    }

    // Reports Collection
    match /reports/{reportId} {
      allow create: if isValidId(reportId)
        && incoming().reason is string
        && incoming().reason.size() <= 200;
      
      allow read, update, delete: if true;
    }
  }
}
